{
  "name": "ripple",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "离线优先的协作看板：自带 CRDT 引擎、同步协议与零依赖 WebSocket 服务器，手机端 PWA",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests/",
    "audit": "node tools/audit.mjs",
    "start": "node server/index.js --port 8787",
    "dev": "node server/index.js --port 8787 --static-only",
    "fuzz": "node tools/fuzz.mjs",
    "bench": "node tools/bench.mjs",
    "icons": "python3 tools/gen-icons.py",
    "check": "npm run audit && npm test"
  },
  "keywords": [
    "crdt",
    "offline-first",
    "pwa",
    "kanban",
    "websocket",
    "local-first"
  ]
}
